            "limit": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "Maximum number of assets to return (default 25)."
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_print_asset",
