            },
            "industry": {
              "type": "string",
              "description": "Industry vertical for the prospect."
            },
            "meeting_objective": {
              "type": "string",
              "description": "What the meeting should achieve."
            },
            "audience": {
              "type": "string",
              "description": "Who is in the room."
            },
            "brand_mode_id": {
              "type": "string",
              "description": "Brand mode id, e.g. 'transperfect'."
            },
            "client_facts": {
              "type": "string",
