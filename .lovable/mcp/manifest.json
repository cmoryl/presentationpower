        "outputSchema": null
      },
      {
        "name": "create_brief",
        "title": "Create brief",
        "description": "Create a new deck brief for the signed-in user, which can then be opened in the app to generate a deck.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "prospect": {
              "type": "string",
              "description": "Prospect or client name."
            },
            "industry": {
              "type": "string",
              "description": "Industry vertical for the prospect."
            },
            "meeting_objective": {
              "type": "string",
              "description": "What the meeting should achieve."
            },
            "audience": {
              "type": "string",
              "description": "Who is in the room."
            },
            "brand_mode_id": {
              "type": "string",
              "description": "Brand mode id, e.g. 'transperfect'."
            },
            "client_facts": {
              "type": "string",
              "description": "Freeform notes and facts about the client."
            }
          },
          "required": [
            "prospect",
            "industry",
            "meeting_objective",
            "audience"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_section_variants",
        "title": "List section frameworks and variants",
        "description": "Browse the deck taxonomy. Without a section_id it lists every section framework; with one it lists the module variants permitted for that section and their allowed layouts.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "section_id": {
              "type": "string",
              "description": "Section framework id, e.g. 'SF-06'. Omit to list all sections."
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "search_icons",
        "title": "Search icon library",
        "description": "Fuzzy-search the curated brand icon library. Returns icon names usable with set_slide_icon.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "What the icon should depict, e.g. 'security' or 'growth'."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 25,
              "description": "Max matches to return (default 10)."
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "search_knowledge",
        "title": "Search knowledge base",
        "description": "Search the division-scoped knowledge base (knowledge entries, brand intel, uploaded brand assets) for verified facts, stats, proof points and client references. Use this before writing any factual claim into a slide.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "What you need verified facts about."
            },
            "division_id": {
              "type": "string",
              "description": "Brand mode / division id to scope the search (default 'transperfect')."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12,
              "description": "Max snippets to return (default 6)."
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "insert_slide",
        "title": "Insert slide",
        "description": "Insert a new slide into a deck at a given position, using a section framework and a module variant permitted for that section. Later slides shift down.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "deck_id": {
              "type": "string",
              "description": "The deck UUID."
            },
            "section_id": {
              "type": "string",
              "description": "Section framework id, e.g. 'SF-06'."
            },
            "variant_id": {
              "type": "string",
              "description": "Module variant id permitted for that section."
            },
            "position": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "0-based insert position. Defaults to the end of the deck."
            },
            "content": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {},
              "description": "Initial slide content object (e.g. { title, subtitle, items })."
            },
            "notes": {
              "type": "string",
              "description": "Optional speaker notes."
            }
          },
          "required": [
            "deck_id",
            "section_id",
            "variant_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "delete_slide",
        "title": "Delete slide",
        "description": "Permanently delete one slide from a deck and close the gap in positions. This cannot be undone from outside the app.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "deck_id": {
              "type": "string",
              "description": "The deck UUID."
            },
            "position": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "0-based slide position to delete."
            }
          },
          "required": [
            "deck_id",
            "position"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "reorder_slides",
        "title": "Reorder slides",
        "description": "Reorder a deck's slides. Pass the full list of current 0-based positions in the desired new order.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "deck_id": {
              "type": "string",
              "description": "The deck UUID."
            },
            "order": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "description": "Every current position exactly once, in the new order. E.g. [0,2,1,3]."
            }
          },
          "required": [
            "deck_id",
            "order"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "update_slide_content",
        "title": "Update slide content",
        "description": "Deep-merge a partial content patch into one slide of a deck. Only include the fields you are changing. Numeric values (stats, dates, currency) are protected unless allow_numeric_edits is true.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "deck_id": {
              "type": "string",
              "description": "The deck UUID."
            },
            "position": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "0-based slide position, as returned by get_deck."
            },
            "patch": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {},
              "description": "Partial content object to deep-merge into the slide's content."
            },
            "allow_numeric_edits": {
              "type": "boolean",
              "description": "Set true only when the user explicitly asked to change numbers or stats."
            }
          },
          "required": [
            "deck_id",
            "position",
            "patch"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "set_slide_icon",
