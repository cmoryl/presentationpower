    "tools": [
      {
        "name": "list_decks",
        "title": "List decks",
        "description": "List the signed-in user's saved presentation decks (id, title, brand, dates).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "Maximum number of decks to return (default 25)."
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_deck",
        "title": "Get deck",
        "description": "Get one deck of the signed-in user, including every slide in order with its full content payload, notes and style-pack / accent settings. Call this before any slide edit so positions and current copy are known.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "deck_id": {
              "type": "string",
              "description": "The deck UUID, as returned by list_decks."
            },
            "include_content": {
              "type": "boolean",
              "description": "Include each slide's full content payload. Defaults to true."
            }
          },
          "required": [
            "deck_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_print_assets",
        "title": "List print assets",
        "description": "List the signed-in user's saved print assets (case studies, spotlights, e-brochures, adaptor briefs).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "description": "Optional kind filter: case-study, spotlight, ebrochure, or adaptor-brief."
            },
            "limit": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "Maximum number of assets to return (default 25)."
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_print_asset",
        "title": "Get print asset",
        "description": "Get one saved print asset of the signed-in user, including its content blocks.",
